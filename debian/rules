#!/usr/bin/make -f
export CARGO_HOME := $(CURDIR)/debian/cargo
export CARGO_TARGET_DIR := $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	rm -rf target debian/cargo
	./build_release_nightly.sh

override_dh_auto_install:
	fakeroot install -D -m0644 rsgit.service debian/rsgit/usr/lib/systemd/system/rsgit.service
	fakeroot install -D -m0755 target/x86_64-unknown-linux-gnu/release/rsgit-web debian/rsgit/usr/bin/rsgit

override_dh_auto_clean:
	rm -rf target debian/cargo
