[Unit]
Description=rsgit — A hyper-hyperfast web frontend for git repositories written in Rust.
Documentation=https://github.com/utoni/rsgit
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/rsgit /srv/git 127.0.0.1:8080
Restart=on-failure
RestartSec=2
DynamicUser=yes
RootDirectory=/var/lib/rsgit/root
MountAPIVFS=yes

BindReadOnlyPaths=/usr/bin/git
BindReadOnlyPaths=/usr/bin/rsgit
BindReadOnlyPaths=/srv/git
BindReadOnlyPaths=/lib64/ld-linux-x86-64.so.2
BindReadOnlyPaths=/lib/x86_64-linux-gnu/libc.so.6
BindReadOnlyPaths=/lib/x86_64-linux-gnu/libm.so.6
BindReadOnlyPaths=/lib/x86_64-linux-gnu/libgcc_s.so.1
BindReadOnlyPaths=/etc/ld.so.cache

MemoryHigh=200M
MemoryMax=256M
MemorySwapMax=0
CPUQuota=25%
CPUWeight=50
TasksMax=64
IOWeight=50
LimitNOFILE=8192

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
